//! Semantic versions (semver 2.0.0): parsing, precedence and display.
//!
//! Build metadata (`+build.5`) is accepted and dropped: it never takes part in precedence,
//! and keeping it would make the derived `Eq`/`Hash` disagree with `Ord`.

from version import Version;

@derive(Eq, Hash, Show)
pub struct SemVer {
    major: int,
    minor: int,
    patch: int,
    /// Dot-separated pre-release identifiers, "" for a release. A string and not `[string]`:
    /// `@derive(Hash)` rejects array fields.
    pre: string,
}

pub fn new(major: int, minor: int, patch: int) -> SemVer {
    SemVer { major: major, minor: minor, patch: patch, pre: "" }
}

pub fn with_pre(major: int, minor: int, patch: int, pre: string) -> SemVer {
    SemVer { major: major, minor: minor, patch: patch, pre: pre }
}

/// `1.2.3`, `1.2.3-rc.1`, `1.2.3-alpha+build.7`. All three numbers are required.
pub fn parse(text: string) -> Result<SemVer, string> {
    let s = text.trim();
    let no_build = match (s.index_of("+")) {
        Option.Some(i) => s.substring(0, i),
        Option.None => s,
    };
    var core = no_build;
    var pre = "";
    match (no_build.index_of("-")) {
        Option.Some(i) => {
            core = no_build.substring(0, i);
            let tail = no_build.substring(i + 1, no_build.len());
            if (tail.len() == 0) { return Result.Err("empty pre-release in '${text}'"); }
            pre = tail;
            for id in tail.split(".") {
                if (!valid_identifier(id)) { return Result.Err("bad pre-release identifier '${id}' in '${text}'"); }
            }
        },
        Option.None => { },
    }
    let parts = core.split(".");
    if (parts.len() != 3) { return Result.Err("expected MAJOR.MINOR.PATCH, got '${text}'"); }
    let major = number(parts[0], text)?;
    let minor = number(parts[1], text)?;
    let patch = number(parts[2], text)?;
    Result.Ok(SemVer { major: major, minor: minor, patch: patch, pre: pre })
}

fn number(part: string, whole: string) -> Result<int, string> {
    if (part.len() == 0 || !all_digits(part)) { return Result.Err("'${part}' is not a number in '${whole}'"); }
    if (part.len() > 1 && part[0] == '0') { return Result.Err("leading zero in '${whole}'"); }
    if (part.len() > 15) { return Result.Err("number too large in '${whole}'"); }
    Result.Ok(parse_int(part).unwrap())
}

fn all_digits(s: string) -> bool {
    for c in s.chars() {
        if (c < '0' || c > '9') { return false; }
    }
    true
}

fn valid_identifier(id: string) -> bool {
    if (id.len() == 0) { return false; }
    for c in id.chars() {
        let ok = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '-';
        if (!ok) { return false; }
    }
    true
}

pub fn text_of(v: SemVer) -> string {
    let core = "${v.major}.${v.minor}.${v.patch}";
    if (v.pre == "") { core } else { core + "-" + v.pre }
}

/// The same release without its pre-release tag: `1.2.0-rc.1` → `1.2.0`.
pub fn release_of(v: SemVer) -> SemVer { new(v.major, v.minor, v.patch) }

/// Exclusive upper bounds of `~` and `^`: `1.2.3` → `1.2.4` / `1.3.0` / `2.0.0`.
pub fn next_patch(v: SemVer) -> SemVer { new(v.major, v.minor, v.patch + 1) }

pub fn next_minor(v: SemVer) -> SemVer { new(v.major, v.minor + 1, 0) }

pub fn next_major(v: SemVer) -> SemVer { new(v.major + 1, 0, 0) }

/// Semver §11: numbers numerically; a version WITH a pre-release is lower than without;
/// identifiers left to right: numeric < alphanumeric, numbers numerically, text in ASCII order;
/// a shorter list is lower when it is a prefix of the other.
pub fn compare(a: SemVer, b: SemVer) -> int {
    if (a.major != b.major) { return sign(a.major - b.major); }
    if (a.minor != b.minor) { return sign(a.minor - b.minor); }
    if (a.patch != b.patch) { return sign(a.patch - b.patch); }
    if (a.pre == b.pre) { return 0; }
    if (a.pre == "") { return 1; }
    if (b.pre == "") { return -1; }
    let pa = a.pre.split(".");
    let pb = b.pre.split(".");
    let la = pa.len();
    let lb = pb.len();
    var i = 0;
    while (i < la && i < lb) {
        let c = compare_identifier(pa[i], pb[i]);
        if (c != 0) { return c; }
        i = i + 1;
    }
    sign(la - lb)
}

fn compare_identifier(x: string, y: string) -> int {
    let nx = all_digits(x);
    let ny = all_digits(y);
    if (nx && ny) {
        if (x.len() != y.len()) { return sign(x.len() - y.len()); }
    } else if (nx) {
        return -1;
    } else if (ny) {
        return 1;
    }
    if (x < y) { -1 } else if (x == y) { 0 } else { 1 }
}

fn sign(n: int) -> int {
    if (n < 0) { -1 } else if (n > 0) { 1 } else { 0 }
}

impl Ord for SemVer {
    fn less(self, other: SemVer) -> bool { compare(self, other) < 0 }
}

impl Version for SemVer {
    fn is_prerelease(self) -> bool { self.pre != "" }
    fn label(self) -> string { text_of(self) }
    fn caret_upper(self) -> Option<SemVer> { Option.Some(caret_bound(self)) }
}

/// Where `^v` stops: the next major, or the next minor below 1.0, or the next patch below 0.1.
pub fn caret_bound(v: SemVer) -> SemVer {
    if (v.major > 0) { next_major(v) } else if (v.minor > 0) { next_minor(v) } else { next_patch(v) }
}
