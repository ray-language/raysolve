//! Version requirements as written in `ray.toml` — `"^0.14.0"`, `"~1.2"`, `"=0.6.1"`,
//! `">=0.3, <0.5"`, `"1.x"`, `"*"`, `"^1.0 || ^2.0"` — turned into a `Range<SemVer>`.
//!
//! A bare version (`"0.14"`) means a caret, like Cargo. Partial versions fill with zeros
//! (`>=1.2` is `>=1.2.0`) except where the operator makes them a span (`=1.2` is `1.2.*`).

import range;
import semver;
from range import Range;
from semver import SemVer;

/// `1`, `1.2`, `1.2.3-rc.1`, with `x`/`X`/`*` standing for a missing part.
struct Partial {
    major: int,
    minor: Option<int>,
    patch: Option<int>,
    pre: string,
}

type Req = Range<SemVer>;

pub fn parse(text: string) -> Result<Req, string> {
    let s = text.trim();
    if (s.len() == 0) {
        return Result.Err("empty requirement");
    }
    var out: Req = range.empty();
    for alt in s.split("||") {
        out = range.union(out, parse_conjunction(alt.trim(), text)?);
    }
    Result.Ok(out)
}

fn parse_conjunction(s: string, whole: string) -> Result<Req, string> {
    if (s.len() == 0) {
        return Result.Err("empty alternative in '${whole}'");
    }
    var acc: Req = range.full();
    for part in s.split(",") {
        let p = part.trim();
        if (p.len() == 0) {
            return Result.Err("empty comparator in '${whole}'");
        }
        acc = range.intersect(acc, comparator(p, whole)?);
    }
    Result.Ok(acc)
}

fn comparator(p: string, whole: string) -> Result<Req, string> {
    if (p == "*") {
        return Result.Ok(range.full());
    }
    for op in [">=", "<=", ">", "<", "=", "^", "~"] {
        match (p.strip_prefix(op)) {
            Option.Some(rest) => return apply(op, partial(rest.trim(), whole)?),
            Option.None => { },
        }
    }
    apply("^", partial(p, whole)?)
}

fn apply(op: string, v: Partial) -> Result<Req, string> {
    let lo = floor_of(v);
    let r = match (op) {
        ">=" => range.at_least(lo),
        ">" => match (v.patch) {
            Option.Some(_) => range.above(lo),
            Option.None => range.at_least(span_end(v)),
        },
        "<" => range.below(lo),
        "<=" => match (v.patch) {
            Option.Some(_) => range.at_most(lo),
            Option.None => range.below(span_end(v)),
        },
        "=" => match (v.patch) {
            Option.Some(_) => range.exact(lo),
            Option.None => range.between(lo, span_end(v)),
        },
        "~" => range.between(lo, tilde_end(v)),
        _ => range.between(lo, caret_end(v)),
    };
    Result.Ok(r)
}

fn floor_of(v: Partial) -> SemVer {
    semver.with_pre(v.major, v.minor.unwrap_or(0), v.patch.unwrap_or(0), v.pre)
}

/// The first version after everything `v` names: `1` → `2.0.0`, `1.2` → `1.3.0`, `1.2.3` → `1.2.4`.
fn span_end(v: Partial) -> SemVer {
    match (v.minor) {
        Option.None => semver.new(v.major + 1, 0, 0),
        Option.Some(mi) => match (v.patch) {
            Option.None => semver.new(v.major, mi + 1, 0),
            Option.Some(pa) => semver.new(v.major, mi, pa + 1),
        },
    }
}

/// `~1.2.3` and `~1.2` stop at the next minor, `~1` at the next major.
fn tilde_end(v: Partial) -> SemVer {
    match (v.minor) {
        Option.None => semver.new(v.major + 1, 0, 0),
        Option.Some(mi) => semver.new(v.major, mi + 1, 0),
    }
}

/// `^` keeps the left-most non-zero part: `^1.2.3` <2.0.0, `^0.14` <0.15.0, `^0.0.3` <0.0.4,
/// `^0.0` <0.1.0, `^0` <1.0.0.
fn caret_end(v: Partial) -> SemVer {
    if (v.major > 0) {
        return semver.new(v.major + 1, 0, 0);
    }
    match (v.minor) {
        Option.None => semver.new(1, 0, 0),
        Option.Some(mi) => if (mi > 0) {
            semver.new(0, mi + 1, 0)
        } else {
            match (v.patch) {
                Option.None => semver.new(0, 1, 0),
                Option.Some(pa) => semver.new(0, 0, pa + 1),
            }
        },
    }
}

fn partial(s: string, whole: string) -> Result<Partial, string> {
    if (s.len() == 0) {
        return Result.Err("missing version in '${whole}'");
    }
    var core = s;
    var pre = "";
    match (s.index_of("-")) {
        Option.Some(i) => {
            core = s.substring(0, i);
            pre = s.substring(i + 1, s.len());
        },
        Option.None => { },
    }
    let parts = core.split(".");
    if (parts.len() > 3) {
        return Result.Err("too many parts in '${s}' ('${whole}')");
    }
    if (wild(parts[0])) {
        return Result.Err("a bare wildcard is written '*' ('${whole}')");
    }
    let major = num(parts[0], whole)?;
    var minor: Option<int> = Option.None;
    var patch: Option<int> = Option.None;
    if (parts.len() > 1 && !wild(parts[1])) {
        minor = Option.Some(num(parts[1], whole)?);
        if (parts.len() > 2 && !wild(parts[2])) {
            patch = Option.Some(num(parts[2], whole)?);
        }
    }
    if (pre != "" && patch.is_none()) {
        return Result.Err("a pre-release needs MAJOR.MINOR.PATCH ('${whole}')");
    }
    if (pre != "") {
        // validate the tag with the real parser
        semver.parse("0.0.0-" + pre).map_err(fn(e: string) -> string { "${e} ('${whole}')" })?;
    }
    Result.Ok(Partial { major: major, minor: minor, patch: patch, pre: pre })
}

fn wild(s: string) -> bool { s == "x" || s == "X" || s == "*" }

fn num(s: string, whole: string) -> Result<int, string> {
    match (parse_int(s)) {
        Option.Some(n) => if (n >= 0 && s.len() < 16) {
            Result.Ok(n)
        } else {
            Result.Err("bad number '${s}' in '${whole}'")
        },
        Option.None => Result.Err("bad number '${s}' in '${whole}'"),
    }
}
