// The generic range algebra (over int and over SemVer) and the ray.toml requirement syntax.

import range;
import req;
import semver;
from range import Range;
from semver import SemVer;

fn v(s: string) -> SemVer { semver.parse(s).unwrap() }

fn r(s: string) -> Range<SemVer> { req.parse(s).unwrap() }

fn show(x: Range<SemVer>) -> string { range.show_range(x) }

@test
fn int_algebra() {
    let a = range.between(1, 10);
    let b = range.between(5, 20);
    let i = range.intersect(a, b);
    assert(range.contains(i, 5));
    assert(!range.contains(i, 10));
    assert(!range.contains(i, 4));
    let u = range.union(range.between(1, 3), range.between(5, 7));
    assert_eq(u.segs.len(), 2);
    assert(range.contains(u, 6));
    assert(!range.contains(u, 4));
    let c = range.complement(u);
    assert(range.contains(c, 4));
    assert(range.contains(c, 0));
    assert(range.contains(c, 100));
    assert(!range.contains(c, 1));
    assert(range.same(range.complement(c), u));
    assert(range.is_full(range.union(u, c)));
    assert(range.is_empty(range.intersect(u, c)));
    assert(range.subset_of(range.exact(2), u));
    assert(!range.subset_of(u, range.between(1, 6)));
    // adjacent intervals merge back into one
    assert_eq(range.union(range.between(1, 3), range.between(3, 5)).segs.len(), 1);
}

@test
fn caret_and_tilde() {
    assert_eq(show(r("^0.14.0")), "^0.14.0");
    assert_eq(show(r("0.14")), "^0.14.0");
    assert_eq(show(r("^1.2.3")), "^1.2.3");
    assert_eq(show(r("^0.0.3")), "^0.0.3");
    assert_eq(show(r("~1.2.3")), ">=1.2.3, <1.3.0");
    assert_eq(show(r("~1")), "^1.0.0");
    assert_eq(show(r("^0")), ">=0.0.0, <1.0.0");
    assert(range.contains(r("^0.14.0"), v("0.14.9")));
    assert(!range.contains(r("^0.14.0"), v("0.15.0")));
    assert(!range.contains(r("^0.14.2"), v("0.14.1")));
}

@test
fn comparators_wildcards_and_alternatives() {
    assert_eq(show(r("=0.6.1")), "0.6.1");
    assert_eq(show(r("=0.6")), "^0.6.0");
    assert_eq(show(r(">=0.3, <0.5")), ">=0.3.0, <0.5.0");
    assert_eq(show(r("1.x")), "^1.0.0");
    assert_eq(show(r("*")), "*");
    assert_eq(show(r(">1.2")), ">=1.3.0");
    assert_eq(show(r("<=1.2")), "<1.3.0");
    assert_eq(show(r("^1.0 || ^3.0")), "^1.0.0 || ^3.0.0");
    assert_eq(show(r("^1.0 || ^1.5")), "^1.0.0");
    assert(range.is_empty(r(">=2.0.0, <1.0.0")));
}

@test
fn prerelease_ranges() {
    let x = r("^1.0.0-rc.1");
    assert(range.contains(x, v("1.0.0-rc.2")));
    assert(range.contains(x, v("1.0.0")));
    assert(!range.contains(x, v("1.0.0-beta")));
}

@test
fn bad_requirements() {
    assert(req.parse("").is_err());
    assert(req.parse("^").is_err());
    assert(req.parse("1.2.3.4").is_err());
    assert(req.parse("^1.x-rc").is_err());
    assert(req.parse(">=1.0,").is_err());
    assert(req.parse("abc").is_err());
}

@test
fn in_range_iterator() {
    let xs = [1, 2, 3, 4, 5, 6, 7, 8];
    let rr = range.union(range.between(2, 4), range.at_least(7));
    assert_eq(range.in_range(xs, rr).collect(), [2, 3, 7, 8]);
    // a for over this bounded impl (it crashed both engines before raylang 1.27.103, #352)
    var seen: [int] = [];
    for v in range.in_range(xs, rr) {
        seen.push(v);
    }
    assert_eq(seen, [2, 3, 7, 8]);
    var it = range.in_range(xs, range.exact(5));
    assert_eq(it.next(), Option.Some(5));
    assert_eq(it.next(), Option.None);
    assert_eq(range.in_range(xs, rr).map(fn(x: int) -> int { x * 10 }).take(2).collect(), [20, 30]);
}
