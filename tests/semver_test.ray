// Semver parsing and precedence (semver 2.0.0 §11), through the hand-written impl Ord.

import semver;
import std/sort;
from semver import SemVer;
from version import Version;

fn v(s: string) -> SemVer { semver.parse(s).unwrap() }

@test
fn parses_core_and_prerelease() {
    let a = v("1.2.3");
    assert_eq(a.major, 1);
    assert_eq(a.patch, 3);
    assert_eq(v("1.0.0-rc.1").pre, "rc.1");
    assert_eq(v("1.0.0-beta+exp.sha.5114f85"), v("1.0.0-beta"));
    assert_eq(v(" 0.14.0 ").label(), "0.14.0");
}

@test
fn rejects_malformed() {
    assert(semver.parse("1.2").is_err());
    assert(semver.parse("1.02.3").is_err());
    assert(semver.parse("1.2.3-").is_err());
    assert(semver.parse("1.2.x").is_err());
    assert(semver.parse("1.2.3-a..b").is_err());
    assert(semver.parse("1.2.3-ñ").is_err());
}

@test
fn precedence_follows_the_spec_example() {
    // the exact chain of semver.org §11
    let chain = ["1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-alpha.beta", "1.0.0-beta", "1.0.0-beta.2",
                 "1.0.0-beta.11", "1.0.0-rc.1", "1.0.0", "2.0.0", "2.1.0", "2.1.1"];
    var i = 0;
    while (i + 1 < chain.len()) {
        assert(v(chain[i]).less(v(chain[i + 1])));
        assert(!v(chain[i + 1]).less(v(chain[i])));
        i = i + 1;
    }
}

@test
fn numbers_compare_numerically() {
    assert(v("1.9.0").less(v("1.10.0")));
    assert(v("1.0.0-rc.9").less(v("1.0.0-rc.10")));
    assert(v("1.0.0-9").less(v("1.0.0-a")));
}

@test
fn sort_and_std_sort_use_the_impl() {
    let xs = [v("1.0.0"), v("0.9.0"), v("1.0.0-rc.1"), v("0.10.0"), v("0.9.0")];
    let sorted = sort(xs).map(fn(x: SemVer) -> string { x.label() });
    assert_eq(sorted, ["0.9.0", "0.9.0", "0.10.0", "1.0.0-rc.1", "1.0.0"]);
    let uniq = sort.dedup(sort(xs));
    assert_eq(uniq.len(), 4);
    assert_eq(sort.binary_search(uniq, v("0.10.0")), Option.Some(1));
    assert_eq(sort.binary_search(uniq, v("0.11.0")), Option.None);
    assert_eq(sort.sort_desc(uniq)[0].label(), "1.0.0");
    let merged = sort.merge([v("0.1.0"), v("0.3.0")], [v("0.2.0")]);
    assert_eq(merged.map(fn(x: SemVer) -> string { x.label() }), ["0.1.0", "0.2.0", "0.3.0"]);
}

@test
fn caret_bounds() {
    assert_eq(semver.caret_bound(v("1.2.3")).label(), "2.0.0");
    assert_eq(semver.caret_bound(v("0.14.2")).label(), "0.15.0");
    assert_eq(semver.caret_bound(v("0.0.3")).label(), "0.0.4");
}
